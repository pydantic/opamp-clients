<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- A real Kestrel application, for the sampler's ASP.NET Core Filter (WebApp.cs). -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.15.0" />
    <Compile Include="../Pydantic.OpAmp.AutoInstrumentation.Tests/WebApp.cs" Link="WebApp.cs" />
    <Compile Include="../Pydantic.OpAmp.AutoInstrumentation.Tests/Undeclared.cs" Link="Undeclared.cs" />
    <Compile Include="../Pydantic.OpAmp.AutoInstrumentation.Tests/Kept.cs" Link="Kept.cs" />
    <Compile Include="../Pydantic.OpAmp.AutoInstrumentation.Tests/Policy.cs" Link="Policy.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="xunit.v3" Version="4.0.1" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Pydantic.OpAmp.Extensions.Hosting/Pydantic.OpAmp.Extensions.Hosting.csproj" />
  </ItemGroup>

</Project>
