{
  "description": "The server takes a shared bootstrap token, offers the agent its own and then accepts only that; the agent restarts halfway and must still get in.",
  "transports": ["http", "ws"],
  "duration_s": 16,
  "needs": ["connection_settings"],
  "driver": {"poll_s": 1, "token": "bootstrap", "accept_connection_settings": true, "runs": [9, 7]},
  "server": {"credentials": {"bootstrap": "bootstrap", "offer": "agent-issued", "offer_on": 2}},
  "checks": ["connection_settings_applied", "connection_settings_applying", "never_locked_out", "driver_survives"]
}
