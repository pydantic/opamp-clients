{
  "description": "The server offers a token it will not accept: the agent reports FAILED and carries on with the bootstrap token.",
  "transports": ["http", "ws"],
  "duration_s": 16,
  "needs": ["connection_settings"],
  "driver": {"poll_s": 1, "token": "bootstrap", "accept_connection_settings": true},
  "server": {"credentials": {"bootstrap": "bootstrap", "offer": "never-accepted", "offer_on": 2, "broken": true}},
  "checks": ["connection_settings_failed", "never_locked_out", "driver_survives"]
}
