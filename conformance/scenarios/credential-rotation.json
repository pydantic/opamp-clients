{
  "description": "The server offers the agent its own token, then a second one once the first works, and accepts only the latest; the agent restarts halfway and must keep the second.",
  "transports": ["http", "ws"],
  "duration_s": 20,
  "needs": ["connection_settings"],
  "driver": {"poll_s": 1, "token": "bootstrap", "accept_connection_settings": true, "runs": [11, 9]},
  "server": {"credentials": {"bootstrap": "bootstrap", "offer": "agent-issued", "offer_on": 2, "then": "agent-reissued"}},
  "checks": ["connection_settings_applied", "connection_settings_rotated", "never_locked_out", "driver_survives"]
}
