# Removes the installed service and package. Keep data and a recovery helper unless --purge.
set -eu
umask 077
fail() { echo "pydantic-opamp-uninstall: $*" >&2; exit 1; }
purge=
dry_run=
for arg in "$@"; do
    case $arg in
        --purge) purge=yes ;;
        --dry-run) dry_run=yes ;;
        --help) echo 'usage: pydantic-opamp-uninstall [--dry-run] [--purge]'; exit 0 ;;
        *) fail "unknown option: $arg" ;;
    esac
done
root=${OPAMP_UNINSTALL_ROOT:-}
case $root in
    '') ;;
    /|*..*) fail 'OPAMP_UNINSTALL_ROOT must name a test directory, not a filesystem root or traversal' ;;
    /*) ;;
    *) fail 'OPAMP_UNINSTALL_ROOT must be absolute' ;;
esac
os=${OPAMP_UNINSTALL_OS:-$(uname -s)}
package=pydantic-opamp-supervisor
case $os in
    Linux)
        config=$root/etc/pydantic-opamp
        state=$root/var/lib/pydantic-opamp
        extra_state=$root/var/lib/pydantic-otelcol
        programs=$root/usr/lib/pydantic-opamp
        dropins=$root/etc/systemd/system/pydantic-opamp-supervisor.service.d
        ;;
    Darwin)
        config=$root/opt/pydantic-opamp/etc
        state=$root/opt/pydantic-opamp/var
        extra_state=
        programs=$root/opt/pydantic-opamp/bin
        dropins=
        ;;
    *) fail "unsupported operating system: $os" ;;
esac
recovery=$config/uninstall
# The unit's drop-in that enrolling with a telemetry token writes: the package's if it holds that and no more.
dropin=${dropins:+$dropins/telemetry.conf}
own_dropin() {
    [ -n "$dropin" ] && [ -f "$dropin" ] && [ ! -L "$dropin" ] || return 1
    [ "$(cat "$dropin")" = '[Service]
LoadCredentialEncrypted=opamp-telemetry-token:/etc/pydantic-opamp/telemetry-token.cred' ]
}
if [ -n "$dry_run" ]; then
    echo "Stop the Collector service and remove the $package package and programs."
    if [ -n "$purge" ]; then
        echo "Delete $config, $state${extra_state:+, $extra_state} and this installation's state key."
        if own_dropin; then echo "Delete $dropin."; elif [ -n "$dropin" ] && [ -e "$dropin" ]; then echo "Keep $dropin: it isn't as this package writes it."; fi
    else
        echo "Keep $config, $state${extra_state:+, $extra_state} and the state key for reinstall."
        echo "Keep $recovery to allow a later purge."
    fi
    exit 0
fi
[ -n "$root" ] || [ "$(id -u)" -eq 0 ] || fail 'run as root'
# Do not follow a redirected parent into another installation or filesystem.
set -- "$config" "$state" "$programs"
if [ "$os" = Darwin ]; then
    set -- "$@" "$root/opt/pydantic-opamp/share/doc" "$root/Library/LaunchDaemons/dev.pydantic.opamp-supervisor.plist"
else
    set -- "$@" "$extra_state"
    [ -z "$purge" ] || set -- "$@" "$dropins"
fi
for directory in "$@"; do
    parent=$directory
    while [ "$parent" != / ] && [ "$parent" != . ]; do
        [ ! -L "$parent" ] || fail "refusing symbolic link: $parent"
        parent=$(dirname "$parent")
    done
done

# Fleet hears of the uninstall from the Supervisor itself, as it stops: the request asks it to tell
# its server, with the credentials it connects with (this script never reads them), and it writes
# what came of it to the notice file. Best effort, bounded by the Supervisor (10 seconds): the
# uninstall goes on whatever came of it. The request stands while this script runs: it is named for
# the script's process. The storage directory is the service user's, so nothing
# of theirs is followed or opened as root: the request is made with mkdir (it follows no link, and
# neither blocks nor truncates), and removed by rmdir; a notice that is a link is not read.
notice_requested=
fleet_told=
fleet_refused=
removed=
request=
ended() {
    [ -z "$request" ] || rmdir "$request" 2>/dev/null || :
    [ -z "$fleet_told" ] || [ -n "$removed" ] ||
        echo 'pydantic-opamp-uninstall: the host is not removed, and Fleet was told it is: its identity and credentials are gone. Run this again to finish.' >&2
}
request_notice() {
    rm -f "$state/uninstall-notice" 2>/dev/null || :
    # When this process started, as /proc has it, so another with its ID since isn't taken for it.
    mark=$(sed 's/.*) //' "/proc/$$/stat" 2>/dev/null | cut -d ' ' -f 20) || mark=
    request=$state/uninstall-requested-$$${mark:+.$mark}
    # A stop that fails (or this script ending) leaves no request: the Supervisor that goes on
    # running must not tell the server at a later stop. Not every shell runs EXIT's on a signal.
    trap ended EXIT
    trap 'exit 129' HUP
    trap 'exit 130' INT
    trap 'exit 143' TERM
    rmdir "$request" 2>/dev/null || :
    if [ -d "$state" ] && [ ! -L "$state" ] && mkdir "$request" 2>/dev/null; then
        notice_requested=yes
    else
        request=
    fi
}
# The notice's first line. The service user can put anything at its path at any time (a link, a
# FIFO that blocks whoever opens it), so a check of the path says nothing about what is opened. It
# is moved, by a rename that follows and opens nothing, into a directory only this script's user can
# enter, and checked and read there. In a subshell, which stands in that directory: the service
# user can move the directory, but not what is in it.
read_notice() (
    box=$state/.uninstall-notice.$$
    mkdir -m 0700 "$box" 2>/dev/null || exit 0
    here=$(cd -P "$state" 2>/dev/null && pwd -P) || exit 0
    if cd -P "$box" 2>/dev/null && [ "$(pwd -P)" = "$here/.uninstall-notice.$$" ] && [ -O . ]; then
        mv -f "$state/uninstall-notice" ./notice 2>/dev/null || :
        if [ -f notice ] && [ ! -L notice ]; then
            head -c 512 notice | head -n 1 || :
        fi
        rm -f notice 2>/dev/null || :
        cd / || :
    fi
    rmdir "$box" 2>/dev/null || :
)
say_notice() {
    [ -n "$notice_requested" ] || return 0
    line=$(read_notice) || line=
    case $line in
        told) fleet_told=yes; echo 'Fleet was told this host is being removed.' ;;
        refused) fleet_refused=yes; echo "Fleet refused this host's credentials (HTTP 401), as it does once they are revoked there." ;;
        'not told: '*) printf '%s\n' "Fleet was not told this host is being removed: ${line#not told: }." ;;
        *) echo 'Fleet was not told this host is being removed: the Supervisor did not say, as it stopped.' ;;
    esac
    rmdir "$request" 2>/dev/null || :
    request=
    rm -f "$state/uninstall-notice" 2>/dev/null || :
    notice_requested=
}

stop_macos() {
    label=system/dev.pydantic.opamp-supervisor
    code=0
    launchctl print "$label" >/dev/null 2>&1 || code=$?
    case $code in
        0) request_notice; launchctl bootout "$label" ;;
        113) return ;;
        *) fail "cannot inspect the Collector service (launchctl $code)" ;;
    esac
    remaining=30
    while :; do
        code=0
        launchctl print "$label" >/dev/null 2>&1 || code=$?
        case $code in
            113) break ;;
            0) [ "$remaining" -gt 0 ] || fail 'Collector service did not stop' ;;
            *) fail "cannot inspect the Collector service (launchctl $code)" ;;
        esac
        sleep 1
        remaining=$((remaining - 1))
    done
}

uninstall() {
    if [ "$os" = Darwin ]; then
        stop_macos
    elif [ -d "$root/run/systemd/system" ]; then
        for unit in pydantic-opamp-supervisor.service pydantic-otelcol.service; do
            load=$(systemctl show --property=LoadState --value "$unit")
            if [ "$load" != not-found ]; then
                if [ "$unit" = pydantic-opamp-supervisor.service ] && systemctl is-active --quiet "$unit"; then
                    request_notice
                fi
                systemctl disable --now "$unit"
            fi
        done
    fi
    say_notice
    # The package manager removes the installed helper. Keep a root-only copy for repeat calls.
    mkdir -p "$config"
    [ ! -L "$recovery" ] || fail "refusing symbolic link: $recovery"
    if [ "$0" != "$recovery" ]; then
        install -m 0700 "$0" "$recovery"
    fi
    if [ "$os" = Darwin ]; then
        # Only the payload from macos/build.sh. Data and the recovery helper stay separate.
        rm -f "$programs/opampsupervisor" "$programs/otelcol" \
            "$programs/pydantic-opamp-enroll" "$programs/pydantic-opamp-uninstall"
        rmdir "$programs" 2>/dev/null || :
        rm -rf "$root/opt/pydantic-opamp/share/doc"
        rm -f "$root/Library/LaunchDaemons/dev.pydantic.opamp-supervisor.plist"
        code=0
        pkgutil --pkg-info dev.pydantic.opamp-supervisor >/dev/null 2>&1 || code=$?
        case $code in
            0) pkgutil --forget dev.pydantic.opamp-supervisor ;;
            1) ;;
            *) fail "cannot inspect package receipt (pkgutil $code)" ;;
        esac
    elif command -v dpkg-query >/dev/null 2>&1; then
        query_code=0
        status=$(dpkg-query -W -f='${db:Status-Status}' "$package" 2>/dev/null) || query_code=$?
        case $query_code in 0|1) ;; *) fail "cannot inspect package status ($query_code)" ;; esac
        case $status in
            installed|half-*|unpacked|triggers-*) dpkg --remove "$package" ;;
            ''|not-installed|config-files) ;;
            *) fail "unexpected package status: $status" ;;
        esac
    elif command -v rpm >/dev/null 2>&1; then
        query_code=0
        rpm -q "$package" >/dev/null 2>&1 || query_code=$?
        case $query_code in
            0) rpm --erase "$package" ;;
            1) ;;
            *) fail "cannot inspect package status ($query_code)" ;;
        esac
    else
        fail 'no supported package database found (dpkg or rpm)'
    fi
    [ ! -e "$programs/opampsupervisor" ] || fail 'package removal left the Supervisor installed; local data was kept'
    if [ -n "$purge" ]; then
        if [ "$os" = Darwin ]; then
            code=0
            security delete-generic-password -s opamp-state-key -a /opt/pydantic-opamp/var/opamp-state \
                /Library/Keychains/System.keychain >/dev/null 2>&1 || code=$?
            case $code in 0|44) ;; *) fail "could not delete the installation state key (security $code)" ;; esac
        fi
        # Enrolled with a telemetry token, the unit has a drop-in that names its credential, which goes
        # with the configuration: the next start would fail on it. Before the recovery helper there goes.
        if own_dropin; then
            rm -f "$dropin"
            rmdir "$dropins" 2>/dev/null || :
            if [ -d "$root/run/systemd/system" ]; then
                systemctl daemon-reload || echo 'pydantic-opamp-uninstall: systemctl daemon-reload failed' >&2
            fi
        elif [ -n "$dropin" ] && [ -e "$dropin" ]; then
            echo "pydantic-opamp-uninstall: $dropin isn't as this package writes it, and is kept" >&2
        fi
        rm -rf "$config" "$state"
        if [ -n "$extra_state" ]; then rm -rf "$extra_state"; fi
        if [ "$os" = Darwin ]; then
            # The package's own directories, once empty. Anything else put there stays.
            rmdir "$root/opt/pydantic-opamp/share" 2>/dev/null || :
            rmdir "$root/opt/pydantic-opamp" 2>/dev/null || :
        fi
    fi
}
# Parse the function before it removes this script from the package.
uninstall
removed=yes
if [ -n "$purge" ]; then
    echo "Removed the Collector service, the $package package and its data."
else
    echo "Removed the Collector service and the $package package. Kept $config, $state and the state key for a reinstall."
    # As root: the kept helper, like the kept data, is root's alone.
    echo "To delete them too, run: sudo $recovery --purge"
fi
if [ -n "$fleet_told" ] && [ -z "$purge" ]; then
    echo "A reinstall enrolls as a new host, with a new enrollment token: this host's identity and credentials went with its enrollment."
fi
[ -n "$fleet_told$fleet_refused" ] || echo "The OpAMP server still lists this host until its credentials are revoked there."
