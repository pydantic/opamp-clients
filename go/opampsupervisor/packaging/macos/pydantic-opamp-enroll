#!/bin/sh
# Copyright (c) 2026 Pydantic Services Inc.
# SPDX-License-Identifier: MIT
#
# pydantic-opamp-enroll (macOS): enrolls this Mac with an OpAMP server in one step.
#
#   echo "$ENROLLMENT_TOKEN" | sudo /opt/pydantic-opamp/bin/pydantic-opamp-enroll --endpoint wss://opamp.example.com/v1/opamp
#
# It writes the enrollment token to a file only root can read (never on the command line), writes
# the Supervisor's config, and starts the LaunchDaemon. The Supervisor seals its state with a key
# it keeps in the System Keychain; the server's issued credentials then replace the enrollment
# token, kept sealed in /opt/pydantic-opamp/var.
#
# OPAMP_ENROLL_ROOT and LAUNCHCTL are for its tests: a root to write under, and the command to
# run in place of launchctl.
set -eu

usage() {
	cat >&2 <<'USAGE'
usage: pydantic-opamp-enroll --endpoint URL [--token-file PATH] [--ca-file PATH] [--plaintext]
                             [--restricted [--exporter-endpoint URL]... [--log-path PATH]... [--host-logs]]
                             [--accept-packages] [--no-start]
       pydantic-opamp-enroll --refresh

  --endpoint URL           the OpAMP server: wss:// or https:// (ws:// and http:// need --plaintext)
  --telemetry-token-stdin  read the enrollment token, then the telemetry token, on two input lines
  --token-file PATH        where to read the enrollment token (default: standard input)
  --ca-file PATH           a CA bundle to trust for the server, in place of the system's
  --plaintext              allow ws:// or http:// (the token then crosses the network in the clear)
  --restricted             limit what the server's configs may do: a few Logfire components, sending
                           only to the --endpoint's host, no environment or file references
                           (default: any config the server sends runs)
  --exporter-endpoint URL  with --restricted, where the server's configs may send telemetry, as
                           scheme://host[:port]; repeat it for more (default: the --endpoint's host)
  --log-path PATH          with --restricted, a file, or a directory, the server's configs may read
                           logs from; repeat it for more (default: none)
  --host-logs              with --restricted, let the server's configs read this Mac's system logs:
                           its unified logs, and the files under /var/log, with read positions
                           kept in /opt/pydantic-opamp/var/collector
  --accept-packages        install the collector the server offers, if this repository's release
                           workflow signed it (default: only the installed collector runs)
  --no-start               write the config and the token, but don't start the Supervisor
  --refresh                write the config again with the last enrollment's options and token, and
                           start the Supervisor again unless it was enrolled with --no-start (a
                           package upgrade runs this; a config edited by hand is kept)
USAGE
	exit 2
}

fail() {
	echo "pydantic-opamp-enroll: $*" >&2
	exit 1
}

# The policy's lists: one item a line. An item can't hold a newline.
nl='
'
append() {
	case $2 in
	*"$nl"*) fail "an --exporter-endpoint or --log-path can't hold a newline" ;;
	esac
	printf '%s' "${1:+$1$nl}$2"
}

# yaml_list prints a list of one item a line as a YAML flow sequence of quoted strings.
yaml_list() {
	set -f
	old_ifs=$IFS
	IFS=$nl
	out=
	for item in $1; do
		out="$out${out:+, }\"$item\""
	done
	IFS=$old_ifs
	set +f
	printf '[%s]' "$out"
}

root=${OPAMP_ENROLL_ROOT:-}
launchctl=${LAUNCHCTL:-launchctl}
supervisor=${OPAMP_SUPERVISOR:-/opt/pydantic-opamp/bin/opampsupervisor}
storage=$root/opt/pydantic-opamp/var
etc=$root/opt/pydantic-opamp/etc
label=dev.pydantic.opamp-supervisor
plist=/Library/LaunchDaemons/$label.plist
# The last enrollment's options (one a line, no credentials) and its config's SHA-256, for --refresh.
options=$etc/enroll.options
written=$etc/supervisor.yaml.sha256
# An older package's enrollment options, read from its config until the new one replaces it.
migrated=$etc/enroll.options.migrated
saved_options=$options

# migrate_options writes the options of an enrollment by a package older than --refresh, which
# kept none, from its config: only one this script wrote without --restricted, where the endpoint,
# --ca-file, --plaintext and --accept-packages are all it could say. It replaces the old config only
# if every setting in it is in the new one (keep_or_replace). A --restricted policy may have been widened or narrowed by hand: it stays.
migrate_options() {
	head -n 1 "$etc/supervisor.yaml" | grep -qx '# Written by pydantic-opamp-enroll.*' || return 1
	! grep -q '^  remote_config_policy:' "$etc/supervisor.yaml" || return 1
	old_endpoint=$(sed -n 's/^  endpoint: "\(.*\)"$/\1/p' "$etc/supervisor.yaml")
	[ -n "$old_endpoint" ] || return 1
	old_ca=$(sed -n 's/^    ca_file: "\(.*\)"$/\1/p' "$etc/supervisor.yaml")
	{
		printf -- '--endpoint\n%s\n' "$old_endpoint"
		[ -z "$old_ca" ] || printf -- '--ca-file\n%s\n' "$old_ca"
		case $old_endpoint in
		ws://* | http://*) printf -- '--plaintext\n' ;;
		esac
		! grep -qx '  accepts_packages: true' "$etc/supervisor.yaml" || printf -- '--accept-packages\n'
	} >"$migrated"
	chmod 0600 "$migrated"
}

# keep_legacy keeps a config an older package wrote, and starts the Supervisor again with it.
keep_legacy() {
	rm -f "$migrated" "$etc/supervisor.yaml.tmp" "$etc/settings.tmp"
	echo "pydantic-opamp-enroll: $etc/supervisor.yaml was written by an older package with --restricted, or edited, and is kept; run pydantic-opamp-enroll again with its options to add this version's settings" >&2
	unload
	load
	echo "restarted the Supervisor ($label)"
	exit 0
}

# unload stops the daemon, if it is loaded, and waits for launchd to let go of it. bootout can
# return while launchd still holds the label (the Supervisor is stopping its Collector), and a
# bootstrap then fails with "Bootstrap failed: 5: Input/output error" and leaves it unloaded.
# A signal from here on waits for load: one that ended this script in between would leave the daemon
# unloaded until the Mac starts again.
unload() {
	ended=
	trap 'ended=129' HUP
	trap 'ended=130' INT
	trap 'ended=143' TERM
	unsignaled "$launchctl" bootout "system/$label" 2>/dev/null || true
	remaining=30
	while unsignaled "$launchctl" print "system/$label" >/dev/null 2>&1; do
		[ "$remaining" -gt 0 ] || fail "$label is still stopping after 30 seconds; once it has stopped, start it with: sudo launchctl bootstrap system $plist"
		unsignaled sleep 1
		remaining=$((remaining - 1))
	done
}

# load loads the daemon that unload unloaded, and then ends on a signal that came meanwhile.
load() {
	unsignaled "$launchctl" bootstrap system "$plist"
	resume_interrupts
}

# Once a restart is safe to interrupt again, exit through the enrollment's cleanup trap.
resume_interrupts() {
	trap 'exit 129' HUP
	trap 'exit 130' INT
	trap 'exit 143' TERM
	[ -z "${ended:-}" ] || exit "$ended"
}

# unsignaled runs a command that the signals (a Ctrl-C reaches the commands here too) don't end.
unsignaled() (
	trap '' HUP INT TERM
	exec "$@"
)

# settings prints a config's settings: its lines but comments and blank ones, sorted.
settings() {
	grep -v -e '^[[:space:]]*#' -e '^[[:space:]]*$' "$1" | LC_ALL=C sort -u
}

endpoint=
exporter_endpoints=
log_paths=
token_file=-
ca_file=
plaintext=
accept_packages=
host_logs=
restricted=
start=yes
telemetry_stdin=
refresh=
restarted_fresh=
kept=
kept_tmp=
stopped=
old_pid=
started=0
saved=
if [ "${1:-}" = --refresh ]; then
	[ $# -eq 1 ] || fail "--refresh takes no other options: it uses the last enrollment's"
	[ -n "$root" ] || [ "$(id -u)" = 0 ] || fail "run it as root"
	[ -f "$etc/supervisor.yaml" ] || fail "this Mac isn't enrolled: run pydantic-opamp-enroll --endpoint URL first"
	refresh=yes
	if [ ! -f "$options" ]; then
		migrate_options || keep_legacy
		saved_options=$migrated
	fi
	set --
	while IFS= read -r line; do
		set -- "$@" "$line"
	done <"$saved_options"
fi
while [ $# -gt 0 ]; do
	# The options --refresh can use again: everything but where the tokens come from.
	case $1 in
	--endpoint | --ca-file | --exporter-endpoint | --log-path) [ $# -ge 2 ] && saved="$saved$1$nl$2$nl" ;;
	--plaintext | --host-logs | --restricted | --accept-packages | --no-start) saved="$saved$1$nl" ;;
	esac
	case $1 in
	--endpoint) [ $# -ge 2 ] || usage; endpoint=$2; shift 2 ;;
	--token-file) [ $# -ge 2 ] || usage; token_file=$2; shift 2 ;;
	--telemetry-token-stdin) telemetry_stdin=yes; shift ;;
	--ca-file) [ $# -ge 2 ] || usage; ca_file=$2; shift 2 ;;
	--plaintext) plaintext=yes; shift ;;
	--exporter-endpoint) [ $# -ge 2 ] || usage; exporter_endpoints=$(append "$exporter_endpoints" "$2"); shift 2 ;;
	--log-path) [ $# -ge 2 ] || usage; log_paths=$(append "$log_paths" "$2"); shift 2 ;;
	--host-logs) host_logs=yes; shift ;;
	--restricted) restricted=yes; shift ;;
	--accept-packages) accept_packages=yes; shift ;;
	--no-start) start=; shift ;;
	*) usage ;;
	esac
done

[ -n "$endpoint" ] || usage
case $endpoint in
wss://* | https://*) ;;
ws://* | http://*) [ -n "$plaintext" ] || fail "$endpoint isn't encrypted; pass --plaintext to use it anyway" ;;
*) fail "the endpoint must be a wss://, https://, ws:// or http:// URL" ;;
esac
case $endpoint in
*'"'* | *'\'* | *' '* | *"$nl"*) fail "the endpoint can't contain quotes, backslashes, spaces or newlines" ;;
esac
authority=${endpoint#*://}
authority=${authority%%/*}
authority=${authority%%\?*}
authority=${authority%%#*}
case $authority in
*@*) fail "the endpoint is scheme://host[:port]/path, with nothing else: $endpoint" ;;
esac
if [ -n "$ca_file" ]; then
	[ -r "$ca_file" ] || fail "can't read $ca_file"
	case $ca_file in
	*'"'* | *'\'* | *"$nl"*) fail "--ca-file can't contain quotes, backslashes or newlines" ;;
	/*) ;;
	*) fail "--ca-file needs an absolute path" ;;
	esac
fi
# The policy's options only widen what --restricted allows: without it, everything is allowed.
if [ -z "$restricted" ] && [ -n "$exporter_endpoints$log_paths$host_logs" ]; then
	fail "--exporter-endpoint, --log-path and --host-logs widen a --restricted policy; without --restricted the server's configs may already send anywhere and read any log"
fi
# Where the remote config's exporters may send: the OpAMP server's host unless given.
if [ -n "$restricted" ] && [ -z "$exporter_endpoints" ]; then
	case $endpoint in
	wss://* | https://*) exporter_endpoints="https://$authority" ;;
	*) exporter_endpoints="http://$authority" ;;
	esac
fi
set -f
old_ifs=$IFS
IFS=$nl
for e in $exporter_endpoints; do
	case $e in
	https://?*) ;;
	http://?*) [ -n "$plaintext" ] || fail "$e isn't encrypted; pass --plaintext to use it anyway" ;;
	*) fail "an exporter endpoint must be an https:// or http:// URL: $e" ;;
	esac
	rest=${e#*://}
	case ${rest%/} in
	*/* | *'?'* | *'#'* | *@* | *'"'* | *'\'* | *' '* | *'$'* | '') fail "an exporter endpoint is scheme://host[:port], with nothing else: $e" ;;
	esac
done
for p in $log_paths; do
	case $p in
	/*) ;;
	*) fail "--log-path needs an absolute path: $p" ;;
	esac
	case $p in
	*'"'* | *'\'* | *'*'* | *'?'* | *'['* | *']'* | *'{'* | *'}'* | *'$'* | *..*) fail "--log-path can't hold quotes, backslashes, glob characters, \$ or ..: $p" ;;
	esac
done
IFS=$old_ifs
set +f
[ -n "$root" ] || [ "$(id -u)" = 0 ] || fail "run it as root"
# --host-logs: the unified log receiver, which reads this Mac's own logs (never an archive), the
# system log files (/var/log is a link to /private/var/log, and a config may name either), and the
# file_storage extension that keeps where a receiver got to, in a directory of the Supervisor's own.
receivers="[otlp, host_metrics, hostmetrics, file_log, filelog, nop]"
extensions="[health_check]"
storage_directories=
if [ -n "$host_logs" ]; then
	receivers="[otlp, host_metrics, hostmetrics, file_log, filelog, nop, macos_unified_logging]"
	log_paths=$(append "$(append "$log_paths" /var/log)" /private/var/log)
	extensions="[health_check, file_storage]"
	storage_directories="$nl    # Where its file_storage extensions may keep files: these directories, and what is under them.
    allowed_storage_directories: [\"/opt/pydantic-opamp/var/collector\"]"
fi

telemetry_token=
token=
if [ -n "$refresh" ]; then
	# The tokens stay as they are.
	[ -f "$etc/enroll-token" ] || fail "$etc/enroll-token is missing: run pydantic-opamp-enroll again with its options and the enrollment token"
elif [ -n "$telemetry_stdin" ]; then
	[ "$token_file" = - ] || fail "--telemetry-token-stdin cannot be combined with --token-file"
	IFS= read -r token || fail "provide an enrollment token on the first input line"
	IFS= read -r telemetry_token || fail "provide a telemetry token on the second input line"
	[ -z "$(cat)" ] || fail "provide exactly two credential lines"
	telemetry_token=$(printf '%s' "$telemetry_token" | tr -d '\r')
	[ -n "$telemetry_token" ] || fail "the telemetry token is empty"
	case $telemetry_token in
	*[!A-Za-z0-9._~+/=-]*) fail "the telemetry token has characters a bearer token cannot contain" ;;
	esac
elif [ "$token_file" = - ]; then
	token=$(cat)
else
	token=$(cat -- "$token_file")
fi
if [ -z "$refresh" ]; then
	# The token goes into an HTTP header: one line, no surrounding space.
	token=$(printf '%s' "$token" | tr -d '\r\n')
	[ -n "$token" ] || fail "the enrollment token is empty"
	case $token in
	*[!A-Za-z0-9._~+/=-]*) fail "the enrollment token has characters a bearer token can't" ;;
	esac
fi

umask 077
mkdir -p "$etc"
chmod 0700 "$etc"

# An enrollment that another run was cut short in (killed, or the host lost power) is a person's to put back:
# this run neither does it nor removes it.
copies() {
	for d in "$etc"/enrollment-before-*; do
		case ${d#"$etc"/enrollment-before-} in
		*[!0-9TZ-]*) continue ;;
		[0-9]*T[0-9]*Z-[0-9]*) ;;
		*) continue ;;
		esac
		if [ -f "$d/put-back" ] && [ ! -L "$d" ]; then echo "$d"; fi
	done
}
for d in $(copies); do
	echo "an earlier pydantic-opamp-enroll was cut short: the enrollment this host had before it (token, config and credentials) is kept in $d. Put it back with: sudo sh $d/put-back    Or, if this host works as it is, remove it with: sudo rm -r $d" >&2
done

# now_json is the Supervisor's status.
now_json() {
	"$supervisor" status --storage "$storage" --json 2>/dev/null || :
}

# keep_enrollment keeps the enrollment of a host its server takes, until the server takes the new one: the core
# uses the credentials the server issued only with the token they were issued for, and one offered for another
# token takes their place. The Supervisor is stopped for it, and root alone reads the copies.
keep_enrollment() {
	[ -z "$refresh" ] && [ -n "$start" ] && [ -f "$etc/enroll-token" ] && [ -f "$etc/supervisor.yaml" ] &&
		[ -f "$storage/opamp-state" ] && [ ! -L "$storage/opamp-state" ] && "$launchctl" print "system/$label" >/dev/null 2>&1 || return 0
	st=$(now_json)
	case $st in *'"accepted": {'*) ;; *) return 0 ;; esac
	old_pid=$(printf '%s\n' "$st" | sed -n 's/^  "pid": \([0-9]*\),*$/\1/p')
	stopped=yes
	unload
	resume_interrupts
	to=$etc/enrollment-before-$(date -u +%Y%m%dT%H%M%SZ)-$$
	kept_tmp=$to.tmp
	# What a run that was killed while it copied left: nothing was changed then. (Not of one that still runs.)
	for d in "$etc"/enrollment-before-*.tmp; do
		pid=${d##*-}
		case ${pid%.tmp} in '' | *[!0-9]*) continue ;; esac
		kill -0 "${pid%.tmp}" 2>/dev/null || rm -rf "$d"
	done
	mkdir "$kept_tmp"
	for f in enroll-token telemetry-token supervisor.yaml enroll.options supervisor.yaml.sha256; do
		# A link as a link.
		{ [ ! -e "$etc/$f" ] && [ ! -L "$etc/$f" ]; } || cp -P -p "$etc/$f" "$kept_tmp/$f"
	done
	cp -P -p "$storage/opamp-state" "$kept_tmp/opamp-state"
	if [ ! -f "$kept_tmp/opamp-state" ] || [ -L "$kept_tmp/opamp-state" ]; then fail "$storage/opamp-state is not a file: nothing is changed"; fi
	cat >"$kept_tmp/put-back" <<EOF
# Puts this host back on the enrollment it had before pydantic-opamp-enroll was run: run it as root.
set -eu
kept=$to etc=$etc storage=$storage label=$label plist=$plist launchctl=$launchctl
EOF
	cat >>"$kept_tmp/put-back" <<'EOF'
umask 077
[ -f "$kept/opamp-state" ] || { echo "nothing is put back: $kept is not there" >&2; exit 1; }
"$launchctl" bootout "system/$label" 2>/dev/null || :
n=0
while "$launchctl" print "system/$label" >/dev/null 2>&1; do
	[ "$n" -lt 30 ] || { echo "the Supervisor ($label) is still stopping: nothing is put back; run this again" >&2; exit 1; }
	sleep 1
	n=$((n + 1))
done
trap '"$launchctl" bootstrap system "$plist"' EXIT
# Whole again if it is cut short: the copies go last. (A file that wasn't there goes.)
one() {
	if [ -e "$kept/$1" ] || [ -L "$kept/$1" ]; then
		rm -f "$2/$1.put-back"
		cp -P -p "$kept/$1" "$2/$1.put-back"
		mv -f "$2/$1.put-back" "$2/$1"
	else
		rm -f "$2/$1"
	fi
}
for f in enroll-token telemetry-token supervisor.yaml enroll.options supervisor.yaml.sha256; do one "$f" "$etc"; done
new=$storage/opamp-state.put-back
rm -f "$new"
cp -p "$kept/opamp-state" "$new"
# What the server offered since, if this isn't the run that tried it.
if [ "${1:-}" != replace ] && [ -e "$storage/opamp-state" ]; then
	mv "$storage/opamp-state" "$storage/opamp-state.replaced-$(date -u +%Y%m%dT%H%M%SZ)-$$"
fi
[ ! -d "$storage/opamp-state" ]
mv -f "$new" "$storage/opamp-state"
rm -rf "$kept"
EOF
	mv "$kept_tmp" "$to"
	kept=$to
	kept_tmp=
}

# put_back ends the run: if it failed, however it did, with the host back on the enrollment it had. Once, and
# only with the Supervisor stopped and the server not having taken the host meanwhile.
put_back() {
	code=$?
	trap - EXIT
	trap '' HUP INT QUIT PIPE TERM
	set +e
	if [ -z "$kept" ]; then
		[ -z "$kept_tmp" ] || rm -rf "$kept_tmp"
		[ -z "$stopped" ] || "$launchctl" print "system/$label" >/dev/null 2>&1 || "$launchctl" bootstrap system "$plist"
		exit "$code"
	fi
	if [ "$code" -eq 0 ] || [ -n "$restarted_fresh" ]; then
		rm -rf "$kept"
		exit "$code"
	fi
	# In a subshell: unload fails the run if it can't.
	if ! (unload); then
		echo "not enrolled with this token, and the Supervisor ($label) can't be stopped to put the earlier enrollment back. It is kept in $kept; put it back with: sudo sh $kept/put-back" >&2
		exit 1
	fi
	st=$(now_json)
	pid=$(printf '%s\n' "$st" | sed -n 's/^  "pid": \([0-9]*\),*$/\1/p')
	started=$(date +%s)
	case $st in
	*'"accepted": {'*)
		# Of the Supervisor this run started, not of the one before.
		if [ -n "$pid" ] && [ "$pid" != "$old_pid" ]; then
			rm -rf "$kept"
			"$launchctl" bootstrap system "$plist"
			if "$supervisor" status --storage "$storage" --wait 30s --since "$started" --require-accepted; then
				echo "Enrolled with $endpoint, late. The Supervisor is running and connected ($label)."
				exit 0
			fi
			echo "the server at $endpoint took this host with this token, and the Supervisor isn't connected now: it keeps retrying; check with: sudo $supervisor status --storage $storage" >&2
			exit 1
		fi
		;;
	esac
	if ! sh "$kept/put-back" replace; then
		echo "not enrolled with this token, and the earlier enrollment could not be put back (why is above). It is kept in $kept; put it back with: sudo sh $kept/put-back" >&2
		exit 1
	fi
	if "$supervisor" status --storage "$storage" --wait 30s --since "$started" --require-accepted >/dev/null; then
		echo "not enrolled with this token: this host is back on the enrollment it had, and connected" >&2
	else
		echo "not enrolled with this token, and with the enrollment it had, which is back, this host isn't accepted now either; check with: sudo $supervisor status --storage $storage" >&2
	fi
	exit 1
}
trap put_back EXIT
trap 'exit 131' QUIT
trap 'exit 141' PIPE
resume_interrupts
keep_enrollment

if [ -z "$refresh" ]; then
	printf '%s' "$token" >"$etc/enroll-token.tmp"
	mv -f "$etc/enroll-token.tmp" "$etc/enroll-token"
fi

if [ -n "$telemetry_stdin" ]; then
	printf '%s' "$telemetry_token" >"$etc/telemetry-token.tmp"
	mv -f "$etc/telemetry-token.tmp" "$etc/telemetry-token"
fi
agent_env=
if [ -f "$etc/telemetry-token" ]; then
	agent_env="  env:
    LOGFIRE_TOKEN: \"\${file:/opt/pydantic-opamp/etc/telemetry-token}\"
"
fi

tls=
if [ -n "$ca_file" ]; then
	tls="  tls:
    ca_file: \"$ca_file\"
"
fi
accepts_packages=
package=
if [ -n "$accept_packages" ]; then
	# The collector executables the server offers are installed if this repository's release
	# workflow signed them (PydanticCosignVerifier in supervisor/config/agent_package.go).
	accepts_packages="$nl  accepts_packages: true"
	package=$nl$(
		cat <<'PACKAGE'

  # The collector the OpAMP server offers is installed if this repository's release workflow
  # signed it, and runs while the server offers it; this one runs again when it stops. The
  # server can't change whose signatures are accepted.
  package:
    agent_binary: otelcol
    verifier:
      type: cosign
      cosign:
        github_workflow_repository: pydantic/opamp-clients
        identities:
          - issuer: https://token.actions.githubusercontent.com
            subject_regex: '^https://github\.com/pydantic/opamp-clients/\.github/workflows/release\.yml@refs/(tags/go/opampsupervisor/v[0-9]+\.[0-9]+\.[0-9]+|heads/main)$'
PACKAGE
	)
fi
# The policy: none unless --restricted, so every config the server sends runs.
policy="  # Any config the OpAMP server sends runs here. To limit what it may configure, and where it may
  # send, run pydantic-opamp-enroll again with --restricted."
if [ -n "$restricted" ]; then
	policy="  # What the server's remote config may do to this host (--restricted). The server can't change
  # this file; widen it here, or run pydantic-opamp-enroll again with --exporter-endpoint,
  # --log-path or --host-logs.
  remote_config_policy:
    # The component types a Logfire config uses, by their names and their older aliases.
    allowed_components:
      receivers: $receivers
      processors: [batch, memory_limiter, resource, resource_detection, resourcedetection, transform]
      exporters: [otlp_grpc, otlp, otlp_http, otlphttp, debug, nop]
      extensions: $extensions
    # No arbitrary \${...}: only locally bound credential environment names are permitted.
    allowed_providers: []
    # Where its exporters, and the collector's own telemetry, may send.
    allowed_exporter_endpoints: $(yaml_list "$exporter_endpoints")
    # What its filelog receivers may read: these files, and what is under these directories.
    allowed_log_paths: $(yaml_list "$log_paths")$storage_directories"
fi
# --refresh keeps a config edited since it was written.
edited=
if [ -n "$refresh" ] && [ -f "$written" ] &&
	[ "$(shasum -a 256 <"$etc/supervisor.yaml" | cut -d ' ' -f 1)" != "$(cat "$written")" ]; then
	edited=yes
	echo "pydantic-opamp-enroll: $etc/supervisor.yaml was edited since it was written and is kept; run pydantic-opamp-enroll again with its options to rewrite it with this version's settings" >&2
fi
[ -n "$edited" ] || cat >"$etc/supervisor.yaml.tmp" <<CONFIG
# Written by pydantic-opamp-enroll. Run it again to enroll with another server or token.
server:
  endpoint: "$endpoint"
  headers:
    # The enrollment token, readable by root alone. Once the server has issued this agent its
    # own credentials, they are used instead (and kept across restarts).
    Authorization: "Bearer \${file:/opt/pydantic-opamp/etc/enroll-token}"
$tls
capabilities:
  accepts_remote_config: true
  accepts_opamp_connection_settings: true
  accepts_other_connection_settings: true
  accepts_restart_command: true
  reports_effective_config: true
  reports_health: true
  # Where the Collector sends its own metrics and logs: the server offers the destination
  # (own_metrics, own_logs), and without an offer they stay local.
  reports_own_metrics: true
  reports_own_logs: true
  reports_available_components: true$accepts_packages

agent:
  connection_env:
    logfire/otlp: LOGFIRE_TOKEN
  executable: /opt/pydantic-opamp/bin/otelcol
  # The Collector has 30 seconds to start and connect back (upstream's 3 is short for a 420 MB
  # binary that a virus scanner checks on its first launch, or a slow disk).
  bootstrap_timeout: 30s
  # A remote config the Collector fails on is replaced by the last one that ran healthy, and stays FAILED.
  automatic_config_rollback: true
  # The Collector's last 4 KiB of log goes with a FAILED config's status, so the server shows why.
  collector_crash_log_snippet_kib: 4
  # A remote config the Collector can't load (a component this Collector doesn't have, a setting a
  # component doesn't know) is refused before it runs: otelcol validate checks it first, the
  # running config stays, and the new one is FAILED with the Collector's reason.
  validate_config: true
  # The Collector counts what goes in and out of every receiver, processor and exporter in each
  # pipeline (otelcol.*.consumed/produced.items), so Fleet can show what each step drops.
  # Feature gates are command-line only, so this can't come from the server's remote config.
  args: [--feature-gates=telemetry.newPipelineTelemetry]
$agent_env

$policy$package

storage:
  directory: /opt/pydantic-opamp/var
  # The issued credentials, sealed with a key the Supervisor keeps in the System Keychain.
  state_key: keychain
CONFIG
# A config an older package wrote is replaced only if the new one has every setting it had: one
# edited by hand (another executable, storage directory or header) is kept.
if [ "$saved_options" = "$migrated" ]; then
	settings "$etc/supervisor.yaml.tmp" >"$etc/settings.tmp"
	[ -z "$(settings "$etc/supervisor.yaml" | LC_ALL=C comm -23 - "$etc/settings.tmp")" ] || keep_legacy
	rm -f "$etc/settings.tmp" "$migrated"
	cp -p "$etc/supervisor.yaml" "$etc/supervisor.yaml.old"
	echo "pydantic-opamp-enroll: rewriting the config an older package wrote; the old one is kept as $etc/supervisor.yaml.old" >&2
fi
if [ -z "$edited" ]; then
	mv -f "$etc/supervisor.yaml.tmp" "$etc/supervisor.yaml"
	shasum -a 256 <"$etc/supervisor.yaml" | cut -d ' ' -f 1 >"$written"
	printf '%s' "$saved" >"$options"
fi

# run_count prints how many times launchd has started the daemon since it was loaded.
run_count() {
	n=$("$launchctl" print "system/$label" 2>/dev/null | awk '$1 == "runs" && $2 == "=" { print $3; exit }') || n=
	case $n in '' | *[!0-9]*) n=0 ;; esac
	echo "$n"
}

# states_aside prints the saved states set aside, one a line. Other names aren't the Supervisor's: whoever
# made them, they go into no command.
states_aside() {
	for f in "$storage"/opamp-state.refused-*-*; do
		case ${f#"$storage"/opamp-state.refused-} in
		*[!0-9TZ.-]*) continue ;;
		[0-9]*T[0-9]*Z*-[0-9]*) ;;
		*) continue ;;
		esac
		if [ -f "$f" ] && [ ! -L "$f" ]; then echo "$f"; fi
	done
}

# new_aside prints the saved state set aside since $1 (states_aside's): the one for this run, if another
# run had one set aside meanwhile.
new_aside() {
	found=
	for f in $(states_aside); do
		case $nl$1$nl in
		*"$nl$f$nl"*) continue ;;
		esac
		case $found in *-$$) ;; *) found=$f ;; esac
	done
	echo "$found"
}

# tell_aside says what $2 are, set aside in $1, and how to put them back (what is in their place then is set
# aside instead).
tell_aside() {
	echo "$2, and the identity kept with them, are set aside in $1. If the server refused them for a while only, put them back with: sudo sh -c 'launchctl bootout system/$label; n=0; while launchctl print system/$label >/dev/null 2>&1 && [ \$n -lt 30 ]; do sleep 1; n=\$((n+1)); done; if launchctl print system/$label >/dev/null 2>&1; then echo still stopping, nothing is put back: run this again >&2; else n=$storage/opamp-state.replaced-\$(date -u +%Y%m%dT%H%M%SZ)-\$\$; if [ -f $1 ]; then { [ ! -e $storage/opamp-state ] || mv $storage/opamp-state \$n; } && { mv $1 $storage/opamp-state || mv \$n $storage/opamp-state; }; else echo nothing is put back, the copy is not there >&2; fi; fi; launchctl bootstrap system $plist'" >&2
}

# tell_earlier is tell_aside of the last that an earlier run had set aside, if there is one and the server
# refuses this host now, too: an outage, or an upgrade, is nothing to put credentials back for.
tell_earlier() {
	[ -z "$refresh" ] || return 0
	st=$("$supervisor" status --storage "$storage" --wait 1s --since "$started" --require-accepted --json 2>/dev/null) || :
	case $st in
	*'"http_status": 401'*) ;;
	*'"accepted": {'*) return 0 ;;
	*'"connected": true'*) ;;
	*) return 0 ;;
	esac
	earlier=$(states_aside | tail -n 1)
	[ -n "$earlier" ] || return 0
	at=$(echo "${earlier##*refused-}" | sed 's/^\(....\)\(..\)\(..\)T\(..\)\(..\)\(..\)Z.*/\1-\2-\3 \4:\5:\6 UTC/')
	echo "if this run had another token than the host enrolled with, enroll again with that one first" >&2
	tell_aside "$earlier" "saved credentials the server refused in an earlier run, at $at"
	[ "$(states_aside | wc -l)" -eq 1 ] || echo "there are more set aside than these, the last: sudo $supervisor status --storage $storage lists them" >&2
}

# fail_wait ends a run whose wait failed.
fail_wait() {
	[ -n "$restarted_fresh" ] || tell_earlier
	exit 1
}

# not_accepted fails the install when the server didn't take the host: it offered it credentials
# that aren't in use, or the Supervisor is connected but the server never answered it. A server that
# takes the connection but not the credentials (a used-up, expired or revoked
# enrollment token) closes it unanswered.
not_accepted() {
	st=$("$supervisor" status --storage "$storage" --json 2>/dev/null) || :
	deleted=", or the server deleted this host, which keeps its identity"
	purge=", or for a deleted host remove its data first (sudo /opt/pydantic-opamp/bin/pydantic-opamp-uninstall --purge)"
	taken="Remove this host's data (sudo /opt/pydantic-opamp/bin/pydantic-opamp-uninstall --purge), then enroll it again with a new token"
	# Not with credentials set aside: a purge removes them.
	if [ -n "$restarted_fresh$(states_aside)$(ls "$storage" | grep '^opamp-state\.replaced-')$(copies)" ]; then
		deleted= purge=
		copied=$(copies)
		taken="Copy what is set aside in $storage${copied:+ and $etc} elsewhere, remove this host's data (sudo /opt/pydantic-opamp/bin/pydantic-opamp-uninstall --purge), then enroll it again with a new token"
	fi
	# The host goes back to the enrollment it had (put_back): nothing more is to be done with this one.
	if [ -n "$kept" ]; then
		host=$(printf '%s\n' "$st" | sed -n 's/.*"unreachable": "\([^"]*\)".*/\1/p')
		case $st in
		*'"identity_taken": true'*) echo "not enrolled: the server at $endpoint holds this host's identity for another installation" >&2 ;;
		*'"unreachable": "'*) echo "not enrolled: the server at $endpoint tells this host to connect to $host, which can't be reached from here (its name, a firewall, a proxy or its certificate)" >&2 ;;
		*'"token_refused": true'*) echo "not enrolled: the server at $endpoint took the connection and not the enrollment token: it may be used up, expired or revoked. Enroll again with a new token" >&2 ;;
		*'"enrollment": {'*) echo "not enrolled: the server at $endpoint answered this host and hasn't taken it. Why is above" >&2 ;;
		*'"connected": true'*) echo "not enrolled: the server at $endpoint took the connection and not the enrollment token: it may be used up, expired or revoked. Enroll again with a new token" >&2 ;;
		*) return 0 ;;
		esac
		fail_wait
	fi
	# The server answered the host and didn't take it ("enrollment" in the status, gone once it
	# does). A refused token is told below.
	if printf '%s\n' "$st" | grep -q '"identity_taken": true'; then
		echo "not enrolled: the server at $endpoint holds this host's identity for another installation (a host it deleted, say). $taken; check with: sudo $supervisor status --storage $storage" >&2
		fail_wait
	fi
	host=$(printf '%s\n' "$st" | sed -n 's/.*"unreachable": "\([^"]*\)".*/\1/p')
	if [ -n "$host" ]; then
		echo "not enrolled: the server at $endpoint tells this host to connect to $host, which can't be reached from here (its name, a firewall, a proxy or its certificate). Once it can, the host enrolls by itself, or at once after a restart of the Supervisor; when it tries again is above. If the server was wrong to, once it is corrected there: $taken; check with: sudo $supervisor status --storage $storage" >&2
		fail_wait
	fi
	if printf '%s\n' "$st" | grep -q '"enrollment": {' && ! printf '%s\n' "$st" | grep -q '"token_refused": true'; then
		echo "not enrolled: the server at $endpoint answered this host and hasn't taken it. Why, how many credentials it offered, and when the host tries again are above; check with: sudo $supervisor status --storage $storage" >&2
		fail_wait
	fi
	if printf '%s\n' "$st" | grep -q '"token_refused": true' || { printf '%s\n' "$st" | grep -q '"connected": true' && ! printf '%s\n' "$st" | grep -q '"accepted": {'; }; then
		echo "enrolled, but the server at $endpoint took the connection and not the enrollment token: it may be used up, expired or revoked$deleted. Enroll again with a new token$purge; check with: sudo $supervisor status --storage $storage" >&2
		fail_wait
	fi
}

# not_saved is whether the state of the host enrolled as a new one isn't saved, a moment after the server took
# it: a restart would lose it.
not_saved() {
	sleep 2
	[ ! -f "$storage/opamp-state" ] || "$supervisor" status --storage "$storage" --json 2>/dev/null | grep -q '"save_error": "'
}

# refused_saved is whether the server refused the credentials it issued this host as not valid (HTTP 401;
# a 403 can mean a missing permission instead), three times or more in a row, with the client's saved
# state there: the client keeps them while the configured token is the same, and never falls back from
# them to the token; the server revoked them (it deleted the host, say).
refused_saved() {
	[ -z "$refresh" ] && [ -z "$restarted_fresh" ] && [ -f "$storage/opamp-state" ] && [ ! -L "$storage/opamp-state" ] || return 1
	# Of the Supervisor started at $1: the status of one before it says nothing of this start.
	"$supervisor" status --storage "$storage" --wait 1s --since "$1" --require-accepted --json 2>/dev/null | grep -Eq '"issued_refused": ([3-9]|[1-9][0-9])'
}

# wait_connected waits up to 30 seconds for the Supervisor started at $1 (Unix seconds) to connect
# and the server to take it (--require-accepted).
# An install that can't reach its server (an untrusted certificate, a refused key) fails here,
# with what to check, instead of reporting success; the service keeps retrying.
wait_connected() {
	if "$supervisor" status --storage "$storage" --wait 30s --since "$1" --require-accepted; then
		return 0
	fi
	# Enrolling (not --refresh) with the token this host enrolled with before, after the server
	# revoked its own credentials: the Supervisor is asked to set those aside, with the instance UID
	# kept with them, as it starts again (supervisor/set_aside.go), once, from the token; a token the
	# server refuses too fails as below. Nothing puts them back but a person, and nothing removes them.
	# A healthy host enrolled again is never refused, and keeps its identity.
	if refused_saved "$1"; then
		restarted_fresh=1
		before=$(states_aside)
		code=0
		request=$storage/opamp-state.set-aside-$$
		rmdir "$request" 2>/dev/null || :
		mkdir "$request" || fail "$request can't be made"
		echo "the server refused this host's saved credentials (it deleted the host, say), so pydantic-opamp-enroll asks the Supervisor to set them aside, with the identity kept with them, and to enroll it again with the enrollment token, as a new host" >&2
		started=$(date +%s)
		runs=$(run_count)
		# One step that launchd ends whatever becomes of this run, not an unload and a load: the daemon's
		# config is the same.
		"$launchctl" kickstart -k "system/$label" || :
		(wait_connected "$started" "$((runs + 1))") || code=$?
		rmdir "$request" 2>/dev/null || :
		aside=$(new_aside "$before")
		if [ "$code" -eq 0 ] && [ -n "$aside" ] && not_saved; then
			code=1
			echo "the server took this host as a new one, and its new credentials could not be saved: a restart loses them. Why: sudo $supervisor status --storage $storage" >&2
		fi
		if [ "$code" -ne 0 ]; then
			if [ -n "$aside" ]; then
				tell_aside "$aside" "this host now enrolls as a new one: the saved credentials the server refused"
			else
				echo "the saved credentials are not set aside: if the Supervisor started, its log says why" >&2
				tell_earlier
			fi
			exit "$code"
		fi
		return 0
	fi
	# A daemon that isn't running, or that launchd has started more than $2 times since the bootstrap
	# (`runs`), never got to connect: say so, and where its log is, instead. The count catches one
	# that crashes a few seconds in, which a single look can find briefly running.
	if ! "$launchctl" print "system/$label" 2>/dev/null | grep -q 'state = running' || [ "$(run_count)" -gt "$2" ]; then
		echo "the Supervisor service ($label) failed to start, so it never connected to $endpoint. Its log says why: sudo tail -n 50 $storage/log/supervisor.log" >&2
		fail_wait
	fi
	not_accepted
	if [ -n "$kept" ]; then
		echo "not enrolled: the Supervisor can't connect to $endpoint. Fix what is above, then enroll again" >&2
		fail_wait
	fi
	echo "enrolled, but the Supervisor can't connect to $endpoint yet; it keeps retrying. Fix what is above, then check with: sudo $supervisor status --storage $storage" >&2
	fail_wait
}

done=Enrolled
[ -z "$refresh" ] || done=Refreshed
if [ -n "$start" ]; then
	# Loaded already (enrolling again, or --refresh): unload it first, so it reads the new config.
	unload
	started=$(date +%s)
	load
	wait_connected "$started" 1
	echo "$done with $endpoint. The Supervisor is running and connected ($label)."
else
	echo "$done with $endpoint. Start the Supervisor with: sudo launchctl bootstrap system $plist"
fi
