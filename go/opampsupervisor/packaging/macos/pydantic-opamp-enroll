#
# pydantic-opamp-enroll (macOS): enrolls this Mac with an OpAMP server in one step.
#
#   echo "$ENROLLMENT_TOKEN" | sudo /opt/pydantic-opamp/bin/pydantic-opamp-enroll --endpoint wss://opamp.example.com/v1/opamp
#
# It writes the enrollment token to a file only root can read (never on the command line), writes
# the Supervisor's config, and starts the LaunchDaemon. The Supervisor seals its state with a key
# it keeps in the System Keychain; the server's issued credentials then replace the enrollment
# token, kept sealed in /opt/pydantic-opamp/var.
#
# OPAMP_ENROLL_ROOT and LAUNCHCTL are for its tests: a root to write under, and the command to
# run in place of launchctl.
set -eu

usage() {
	cat >&2 <<'USAGE'
usage: pydantic-opamp-enroll --endpoint URL [--token-file PATH] [--ca-file PATH] [--no-start]

  --endpoint URL     the OpAMP server: wss:// or https:// (ws:// and http:// need --plaintext)
  --token-file PATH  where to read the enrollment token (default: standard input)
  --ca-file PATH     a CA bundle to trust for the server, in place of the system's
  --plaintext        allow ws:// or http:// (the token then crosses the network in the clear)
  --no-start         write the config and the token, but don't start the Supervisor
USAGE
	exit 2
}

fail() {
	echo "pydantic-opamp-enroll: $*" >&2
	exit 1
}

root=${OPAMP_ENROLL_ROOT:-}
launchctl=${LAUNCHCTL:-launchctl}
etc=$root/opt/pydantic-opamp/etc
label=dev.pydantic.opamp-supervisor
plist=/Library/LaunchDaemons/$label.plist

endpoint=
token_file=-
ca_file=
plaintext=
start=yes
while [ $# -gt 0 ]; do
	case $1 in
	--endpoint) [ $# -ge 2 ] || usage; endpoint=$2; shift 2 ;;
	--token-file) [ $# -ge 2 ] || usage; token_file=$2; shift 2 ;;
	--ca-file) [ $# -ge 2 ] || usage; ca_file=$2; shift 2 ;;
	--plaintext) plaintext=yes; shift ;;
	--no-start) start=; shift ;;
	*) usage ;;
	esac
done

[ -n "$endpoint" ] || usage
case $endpoint in
wss://* | https://*) ;;
ws://* | http://*) [ -n "$plaintext" ] || fail "$endpoint isn't encrypted; pass --plaintext to use it anyway" ;;
*) fail "the endpoint must be a wss://, https://, ws:// or http:// URL" ;;
esac
case $endpoint in
*'"'* | *'\'* | *' '*) fail "the endpoint can't contain quotes, backslashes or spaces" ;;
esac
if [ -n "$ca_file" ]; then
	[ -r "$ca_file" ] || fail "can't read $ca_file"
	case $ca_file in
	*'"'* | *'\'*) fail "--ca-file can't contain quotes or backslashes" ;;
	/*) ;;
	*) fail "--ca-file needs an absolute path" ;;
	esac
fi
[ -n "$root" ] || [ "$(id -u)" = 0 ] || fail "run it as root"

if [ "$token_file" = - ]; then
	token=$(cat)
else
	token=$(cat -- "$token_file")
fi
# The token goes into an HTTP header: one line, no surrounding space.
token=$(printf '%s' "$token" | tr -d '\r\n')
[ -n "$token" ] || fail "the enrollment token is empty"
case $token in
*[!A-Za-z0-9._~+/=-]*) fail "the enrollment token has characters a bearer token can't" ;;
esac

umask 077
mkdir -p "$etc"
chmod 0700 "$etc"
printf '%s' "$token" >"$etc/enroll-token.tmp"
mv -f "$etc/enroll-token.tmp" "$etc/enroll-token"

tls=
if [ -n "$ca_file" ]; then
	tls="  tls:
    ca_file: \"$ca_file\"
"
fi
cat >"$etc/supervisor.yaml.tmp" <<CONFIG
# Written by pydantic-opamp-enroll. Run it again to enroll with another server or token.
server:
  endpoint: "$endpoint"
  headers:
    # The enrollment token, readable by root alone. Once the server has issued this agent its
    # own credentials, they are used instead (and kept across restarts).
    Authorization: "Bearer \${file:/opt/pydantic-opamp/etc/enroll-token}"
$tls
capabilities:
  accepts_remote_config: true
  accepts_opamp_connection_settings: true
  reports_effective_config: true
  reports_health: true
  reports_available_components: true

agent:
  executable: /opt/pydantic-opamp/bin/otelcol

storage:
  directory: /opt/pydantic-opamp/var
  # The issued credentials, sealed with a key the Supervisor keeps in the System Keychain.
  state_key: keychain
CONFIG
mv -f "$etc/supervisor.yaml.tmp" "$etc/supervisor.yaml"

if [ -n "$start" ]; then
	# Loaded already (enrolling again): unload it first, so it reads the new config.
	"$launchctl" bootout "system/$label" 2>/dev/null || true
	"$launchctl" bootstrap system "$plist"
	echo "enrolled with $endpoint; the Supervisor is running ($label)"
else
	echo "enrolled with $endpoint; start the Supervisor with: sudo launchctl bootstrap system $plist"
fi
