#!/bin/sh
# pydantic-opamp-enroll: enrolls this host with an OpAMP server in one step.
#
#   echo "$ENROLLMENT_TOKEN" | sudo pydantic-opamp-enroll --endpoint wss://opamp.example.com/v1/opamp
#
# It encrypts the enrollment token to this host with systemd-creds (never on the command line),
# makes the key that encrypts the Supervisor's state (once: a new one would lose the issued
# credentials), writes the Supervisor's config, and starts the service. The server's issued
# credentials then replace the enrollment token, kept encrypted in /var/lib/pydantic-opamp.
#
# OPAMP_ENROLL_ROOT, SYSTEMD_CREDS and SYSTEMCTL are for its tests: a root to write under, and
# the commands to run in place of systemd's.
set -eu

usage() {
	cat >&2 <<'EOF'
usage: pydantic-opamp-enroll --endpoint URL [--token-file PATH] [--ca-file PATH] [--plaintext]
                             [--restricted [--exporter-endpoint URL]... [--log-path PATH]... [--host-logs]]
                             [--accept-packages] [--no-start]
       pydantic-opamp-enroll --refresh

  --endpoint URL           the OpAMP server: wss:// or https:// (ws:// and http:// need --plaintext)
  --telemetry-token-stdin  read the enrollment token, then the telemetry token, on two input lines
  --token-file PATH        where to read the enrollment token (default: standard input)
  --ca-file PATH           a CA bundle to trust for the server, in place of the system's
  --plaintext              allow ws:// or http:// (the token then crosses the network in the clear)
  --restricted             limit what the server's configs may do: a few Logfire components, sending
                           only to the --endpoint's host, no environment or file references
                           (default: any config the server sends runs)
  --exporter-endpoint URL  with --restricted, where the server's configs may send telemetry, as
                           scheme://host[:port]; repeat it for more (default: the --endpoint's host)
  --log-path PATH          with --restricted, a file, or a directory, the server's configs may read
                           logs from; repeat it for more (default: none)
  --host-logs              with --restricted, let the server's configs read this host's system logs:
                           the files under /var/log, with read positions kept in
                           /var/lib/pydantic-opamp/collector
  --accept-packages        install the collector the server offers, if this repository's release
                           workflow signed it (default: only the installed collector runs)
  --no-start               write the config and credentials, but don't start the service
  --refresh                write the config again with the last enrollment's options and credentials,
                           and start the service again unless it was enrolled with --no-start (a
                           package upgrade runs this; a config edited by hand is kept)
EOF
	exit 2
}

fail() {
	echo "pydantic-opamp-enroll: $*" >&2
	exit 1
}

# The policy's lists: one item a line. An item can't hold a newline.
nl='
'
append() {
	case $2 in
	*"$nl"*) fail "an --exporter-endpoint or --log-path can't hold a newline" ;;
	esac
	printf '%s' "${1:+$1$nl}$2"
}

# yaml_list prints a list of one item a line as a YAML flow sequence of quoted strings.
yaml_list() {
	set -f
	old_ifs=$IFS
	IFS=$nl
	out=
	for item in $1; do
		out="$out${out:+, }\"$item\""
	done
	IFS=$old_ifs
	set +f
	printf '[%s]' "$out"
}

# migrate_options writes the options of an enrollment by a package older than --refresh, which
# kept none, from its config: only one this script wrote without --restricted, where the endpoint,
# --plaintext and --accept-packages are all it could say. It replaces the old config only if
# every setting in it is in the new one (keep_or_replace). A --restricted policy may have been widened or narrowed by hand: it stays.
migrate_options() {
	head -n 1 "$etc/supervisor.yaml" | grep -qx '# Written by pydantic-opamp-enroll.*' || return 1
	! grep -q '^  remote_config_policy:' "$etc/supervisor.yaml" || return 1
	old_endpoint=$(sed -n 's/^  endpoint: "\(.*\)"$/\1/p' "$etc/supervisor.yaml")
	[ -n "$old_endpoint" ] || return 1
	{
		printf -- '--endpoint\n%s\n' "$old_endpoint"
		case $old_endpoint in
		ws://* | http://*) printf -- '--plaintext\n' ;;
		esac
		! grep -qx '  accepts_packages: true' "$etc/supervisor.yaml" || printf -- '--accept-packages\n'
	} >"$migrated"
	chmod 0600 "$migrated"
}

# keep_legacy keeps a config an older package wrote, and starts the Supervisor again with it.
keep_legacy() {
	rm -f "$migrated" "$etc/supervisor.yaml.tmp" "$etc/settings.tmp"
	echo "pydantic-opamp-enroll: $etc/supervisor.yaml was written by an older package with --restricted, or edited, and is kept; run pydantic-opamp-enroll again with its options to add this version's settings" >&2
	"$systemctl" disable --now pydantic-otelcol.service
	"$systemctl" enable "$unit"
	"$systemctl" restart "$unit"
	echo "restarted the Supervisor ($unit)"
	exit 0
}

# settings prints a config's settings: its lines but comments and blank ones, sorted.
settings() {
	grep -v -e '^[[:space:]]*#' -e '^[[:space:]]*$' "$1" | LC_ALL=C sort -u
}

root=${OPAMP_ENROLL_ROOT:-}
creds=${SYSTEMD_CREDS:-systemd-creds}
systemctl=${SYSTEMCTL:-systemctl}
supervisor=${OPAMP_SUPERVISOR:-/usr/lib/pydantic-opamp/opampsupervisor}
storage=$root/var/lib/pydantic-opamp
etc=$root/etc/pydantic-opamp
unit=pydantic-opamp-supervisor.service
# The last enrollment's options (one a line, no credentials) and its config's SHA-256, for --refresh.
options=$etc/enroll.options
written=$etc/supervisor.yaml.sha256
# An older package's enrollment options, read from its config until the new one replaces it.
migrated=$etc/enroll.options.migrated
saved_options=$options

endpoint=
exporter_endpoints=
log_paths=
token_file=-
ca_file=
plaintext=
accept_packages=
host_logs=
restricted=
start=yes
telemetry_stdin=
refresh=
saved=
if [ "${1:-}" = --refresh ]; then
	[ $# -eq 1 ] || fail "--refresh takes no other options: it uses the last enrollment's"
	[ -n "$root" ] || [ "$(id -u)" = 0 ] || fail "run it as root"
	[ -f "$etc/supervisor.yaml" ] || fail "this host isn't enrolled: run pydantic-opamp-enroll --endpoint URL first"
	refresh=yes
	if [ ! -f "$options" ]; then
		migrate_options || keep_legacy
		saved_options=$migrated
	fi
	set --
	while IFS= read -r line; do
		set -- "$@" "$line"
	done <"$saved_options"
fi
while [ $# -gt 0 ]; do
	# The options --refresh can use again: everything but where the credentials come from.
	case $1 in
	--endpoint | --exporter-endpoint | --log-path) [ $# -ge 2 ] && saved="$saved$1$nl$2$nl" ;;
	--plaintext | --host-logs | --restricted | --accept-packages | --no-start) saved="$saved$1$nl" ;;
	esac
	case $1 in
	--endpoint) [ $# -ge 2 ] || usage; endpoint=$2; shift 2 ;;
	--token-file) [ $# -ge 2 ] || usage; token_file=$2; shift 2 ;;
	--telemetry-token-stdin) telemetry_stdin=yes; shift ;;
	--ca-file) [ $# -ge 2 ] || usage; ca_file=$2; shift 2 ;;
	--plaintext) plaintext=yes; shift ;;
	--exporter-endpoint) [ $# -ge 2 ] || usage; exporter_endpoints=$(append "$exporter_endpoints" "$2"); shift 2 ;;
	--log-path) [ $# -ge 2 ] || usage; log_paths=$(append "$log_paths" "$2"); shift 2 ;;
	--host-logs) host_logs=yes; shift ;;
	--restricted) restricted=yes; shift ;;
	--accept-packages) accept_packages=yes; shift ;;
	--no-start) start=; shift ;;
	*) usage ;;
	esac
done

[ -n "$endpoint" ] || usage
case $endpoint in
wss://* | https://*) ;;
ws://* | http://*) [ -n "$plaintext" ] || fail "$endpoint isn't encrypted; pass --plaintext to use it anyway" ;;
*) fail "the endpoint must be a wss://, https://, ws:// or http:// URL" ;;
esac
case $endpoint in
*'"'* | *'\'* | *' '* | *"$nl"*) fail "the endpoint can't contain quotes, backslashes, spaces or newlines" ;;
esac
authority=${endpoint#*://}
authority=${authority%%/*}
authority=${authority%%\?*}
authority=${authority%%#*}
case $authority in
*@*) fail "the endpoint is scheme://host[:port]/path, with nothing else: $endpoint" ;;
esac
if [ -n "$ca_file" ]; then
	[ -r "$ca_file" ] || fail "can't read $ca_file"
	case $ca_file in
	/*) ;;
	*) fail "--ca-file needs an absolute path" ;;
	esac
fi
# The policy's options only narrow what --restricted allows: without it, everything is allowed.
if [ -z "$restricted" ] && [ -n "$exporter_endpoints$log_paths$host_logs" ]; then
	fail "--exporter-endpoint, --log-path and --host-logs widen a --restricted policy; without --restricted the server's configs may already send anywhere and read any log"
fi
# Where the remote config's exporters may send: the OpAMP server's host unless given.
if [ -n "$restricted" ] && [ -z "$exporter_endpoints" ]; then
	case $endpoint in
	wss://* | https://*) exporter_endpoints="https://$authority" ;;
	*) exporter_endpoints="http://$authority" ;;
	esac
fi
set -f
old_ifs=$IFS
IFS=$nl
for e in $exporter_endpoints; do
	case $e in
	https://?*) ;;
	http://?*) [ -n "$plaintext" ] || fail "$e isn't encrypted; pass --plaintext to use it anyway" ;;
	*) fail "an exporter endpoint must be an https:// or http:// URL: $e" ;;
	esac
	rest=${e#*://}
	case ${rest%/} in
	*/* | *'?'* | *'#'* | *@* | *'"'* | *'\'* | *' '* | *'$'* | '') fail "an exporter endpoint is scheme://host[:port], with nothing else: $e" ;;
	esac
done
for p in $log_paths; do
	case $p in
	/*) ;;
	*) fail "--log-path needs an absolute path: $p" ;;
	esac
	case $p in
	*'"'* | *'\'* | *'*'* | *'?'* | *'['* | *']'* | *'{'* | *'}'* | *'$'* | *..*) fail "--log-path can't hold quotes, backslashes, glob characters, \$ or ..: $p" ;;
	esac
done
IFS=$old_ifs
set +f
[ -n "$root" ] || [ "$(id -u)" = 0 ] || fail "run it as root"
# --host-logs: the system log files, and the file_storage extension that keeps where a receiver
# got to, in a directory of the Supervisor's own.
extensions="[health_check]"
storage_directories=
if [ -n "$host_logs" ]; then
	log_paths=$(append "$log_paths" /var/log)
	extensions="[health_check, file_storage]"
	storage_directories="$nl    # Where its file_storage extensions may keep files: these directories, and what is under them.
    allowed_storage_directories: [\"/var/lib/pydantic-opamp/collector\"]"
fi

telemetry_token=
token=
if [ -n "$refresh" ]; then
	# The sealed tokens stay as they are.
	[ -f "$etc/enroll-token.cred" ] || fail "$etc/enroll-token.cred is missing: run pydantic-opamp-enroll again with its options and the enrollment token"
elif [ -n "$telemetry_stdin" ]; then
	[ "$token_file" = - ] || fail "--telemetry-token-stdin cannot be combined with --token-file"
	IFS= read -r token || fail "provide an enrollment token on the first input line"
	IFS= read -r telemetry_token || fail "provide a telemetry token on the second input line"
	[ -z "$(cat)" ] || fail "provide exactly two credential lines"
	telemetry_token=$(printf '%s' "$telemetry_token" | tr -d '\r')
	[ -n "$telemetry_token" ] || fail "the telemetry token is empty"
	case $telemetry_token in
	*[!A-Za-z0-9._~+/=-]*) fail "the telemetry token has characters a bearer token cannot contain" ;;
	esac
elif [ "$token_file" = - ]; then
	token=$(cat)
else
	token=$(cat -- "$token_file")
fi
if [ -z "$refresh" ]; then
	# The token goes into an HTTP header: one line, no surrounding space.
	token=$(printf '%s' "$token" | tr -d '\r\n')
	[ -n "$token" ] || fail "the enrollment token is empty"
	case $token in
	*[!A-Za-z0-9._~+/=-]*) fail "the enrollment token has characters a bearer token can't" ;;
	esac
fi

umask 077
mkdir -p "$etc"
chmod 0750 "$etc"

if [ -z "$refresh" ]; then
	printf '%s' "$token" | "$creds" encrypt --name=opamp-enroll-token - "$etc/enroll-token.cred.tmp"
	chmod 0600 "$etc/enroll-token.cred.tmp"
	mv -f "$etc/enroll-token.cred.tmp" "$etc/enroll-token.cred"
fi

if [ -n "$telemetry_stdin" ]; then
	printf '%s' "$telemetry_token" | "$creds" encrypt --name=opamp-telemetry-token - "$etc/telemetry-token.cred.tmp"
	chmod 0600 "$etc/telemetry-token.cred.tmp"
	mv -f "$etc/telemetry-token.cred.tmp" "$etc/telemetry-token.cred"
	dropin=$root/etc/systemd/system/$unit.d
	mkdir -p "$dropin"
	printf '[Service]\nLoadCredentialEncrypted=opamp-telemetry-token:/etc/pydantic-opamp/telemetry-token.cred\n' >"$dropin/telemetry.conf"
	"$systemctl" daemon-reload
fi

agent_env=
if [ -f "$etc/telemetry-token.cred" ]; then
	agent_env="  env:
    LOGFIRE_TOKEN: \"\${file:/run/credentials/$unit/opamp-telemetry-token}\"
"
fi

if [ ! -e "$etc/state-key.cred" ]; then
	# A new key can't open a state file sealed with the old one, so it is made only once.
	head -c 32 /dev/urandom | "$creds" encrypt --name=opamp-state-key - "$etc/state-key.cred.tmp"
	chmod 0600 "$etc/state-key.cred.tmp"
	mv "$etc/state-key.cred.tmp" "$etc/state-key.cred"
fi

tls=
if [ -n "$ca_file" ]; then
	# A copy beside the config: the service has a private /tmp and can't read most home directories,
	# so a bundle left where it was given can stop the Supervisor from starting.
	cp -- "$ca_file" "$etc/ca.pem.tmp"
	chmod 0640 "$etc/ca.pem.tmp"
	mv -f "$etc/ca.pem.tmp" "$etc/ca.pem"
	tls="  tls:
    ca_file: \"/etc/pydantic-opamp/ca.pem\"
"
elif [ -n "$refresh" ] && [ -f "$etc/ca.pem" ]; then
	# --refresh keeps the copy the last enrollment made.
	tls="  tls:
    ca_file: \"/etc/pydantic-opamp/ca.pem\"
"
else
	# Without --ca-file the system's CAs are trusted: no copy is left for --refresh to find.
	rm -f "$etc/ca.pem"
fi
accepts_packages=
package=
if [ -n "$accept_packages" ]; then
	# The collector executables the server offers are installed if this repository's release
	# workflow signed them (PydanticCosignVerifier in supervisor/config/agent_package.go).
	accepts_packages="$nl  accepts_packages: true"
	package=$nl$(
		cat <<'PACKAGE'

  # The collector the OpAMP server offers is installed if this repository's release workflow
  # signed it, and runs while the server offers it; this one runs again when it stops. The
  # server can't change whose signatures are accepted.
  package:
    agent_binary: otelcol
    verifier:
      type: cosign
      cosign:
        github_workflow_repository: pydantic/opamp-clients
        identities:
          - issuer: https://token.actions.githubusercontent.com
            subject_regex: '^https://github\.com/pydantic/opamp-clients/\.github/workflows/release\.yml@refs/(tags/go/opampsupervisor/v[0-9]+\.[0-9]+\.[0-9]+|heads/main)$'
PACKAGE
	)
fi
# The policy: none unless --restricted, so every config the server sends runs.
policy="  # Any config the OpAMP server sends runs here. To limit what it may configure, and where it may
  # send, run pydantic-opamp-enroll again with --restricted."
if [ -n "$restricted" ]; then
	policy="  # What the server's remote config may do to this host (--restricted). The server can't change
  # this file; widen it here, or run pydantic-opamp-enroll again with --exporter-endpoint,
  # --log-path or --host-logs.
  remote_config_policy:
    # The component types a Logfire config uses, by their names and their older aliases.
    allowed_components:
      receivers: [otlp, host_metrics, hostmetrics, file_log, filelog, nop]
      processors: [batch, memory_limiter, resource, resource_detection, resourcedetection]
      exporters: [otlp_grpc, otlp, otlp_http, otlphttp, debug, nop]
      extensions: $extensions
    # No arbitrary \${...}: only locally bound credential environment names are permitted.
    allowed_providers: []
    # Where its exporters, and the collector's own telemetry, may send.
    allowed_exporter_endpoints: $(yaml_list "$exporter_endpoints")
    # What its filelog receivers may read: these files, and what is under these directories.
    allowed_log_paths: $(yaml_list "$log_paths")$storage_directories"
fi
# --refresh keeps a config edited since it was written.
edited=
if [ -n "$refresh" ] && [ -f "$written" ] &&
	[ "$(sha256sum <"$etc/supervisor.yaml" | cut -d ' ' -f 1)" != "$(cat "$written")" ]; then
	edited=yes
	echo "pydantic-opamp-enroll: $etc/supervisor.yaml was edited since it was written and is kept; run pydantic-opamp-enroll again with its options to rewrite it with this version's settings" >&2
fi
[ -n "$edited" ] || cat >"$etc/supervisor.yaml.tmp" <<EOF
# Written by pydantic-opamp-enroll. Run it again to enroll with another server or token.
server:
  endpoint: "$endpoint"
  headers:
    # The enrollment token, decrypted by systemd for this service alone. Once the server has
    # issued this agent its own credentials, they are used instead (and kept across restarts).
    Authorization: "Bearer \${file:/run/credentials/$unit/opamp-enroll-token}"
$tls
capabilities:
  accepts_remote_config: true
  accepts_opamp_connection_settings: true
  accepts_other_connection_settings: true
  accepts_restart_command: true
  reports_effective_config: true
  reports_health: true
  # Where the Collector sends its own metrics and logs: the server offers the destination
  # (own_metrics, own_logs), and without an offer they stay local.
  reports_own_metrics: true
  reports_own_logs: true
  reports_available_components: true$accepts_packages

agent:
  connection_env:
    logfire/otlp: LOGFIRE_TOKEN
  executable: /usr/lib/pydantic-opamp/otelcol
  # The Collector has 30 seconds to start and connect back (upstream's 3 is short for a 420 MB
  # binary that a virus scanner checks on its first launch, or a slow disk).
  bootstrap_timeout: 30s
  # A remote config the Collector fails on is replaced by the last one that ran healthy, and stays FAILED.
  automatic_config_rollback: true
  # The Collector's last 4 KiB of log goes with a FAILED config's status, so the server shows why.
  collector_crash_log_snippet_kib: 4
  # A remote config the Collector can't load (a component this Collector doesn't have, a setting a
  # component doesn't know) is refused before it runs: otelcol validate checks it first, the
  # running config stays, and the new one is FAILED with the Collector's reason.
  validate_config: true
  # The Collector counts what goes in and out of every receiver, processor and exporter in each
  # pipeline (otelcol.*.consumed/produced.items), so Fleet can show what each step drops.
  # Feature gates are command-line only, so this can't come from the server's remote config.
  args: [--feature-gates=telemetry.newPipelineTelemetry]
$agent_env

$policy$package

storage:
  directory: /var/lib/pydantic-opamp
  # The issued credentials, encrypted with the key systemd decrypts from state-key.cred.
  state_key: systemd-creds
EOF
# A config an older package wrote is replaced only if the new one has every setting it had: one
# edited by hand (another executable, storage directory or header) is kept.
if [ "$saved_options" = "$migrated" ]; then
	settings "$etc/supervisor.yaml.tmp" >"$etc/settings.tmp"
	[ -z "$(settings "$etc/supervisor.yaml" | LC_ALL=C comm -23 - "$etc/settings.tmp")" ] || keep_legacy
	rm -f "$etc/settings.tmp" "$migrated"
	cp -p "$etc/supervisor.yaml" "$etc/supervisor.yaml.old"
	echo "pydantic-opamp-enroll: rewriting the config an older package wrote; the old one is kept as $etc/supervisor.yaml.old" >&2
fi
if [ -z "$edited" ]; then
	chmod 0640 "$etc/supervisor.yaml.tmp"
	mv -f "$etc/supervisor.yaml.tmp" "$etc/supervisor.yaml"
	sha256sum <"$etc/supervisor.yaml" | cut -d ' ' -f 1 >"$written"
	printf '%s' "$saved" >"$options"
fi
if getent group pydantic-opamp >/dev/null 2>&1 && [ "$(id -u)" = 0 ]; then
	chgrp pydantic-opamp "$etc" "$etc/supervisor.yaml"
	[ ! -e "$etc/ca.pem" ] || chgrp pydantic-opamp "$etc/ca.pem"
fi

# wait_connected waits up to 30 seconds for the Supervisor started at $1 (Unix seconds) to connect.
# An install that can't reach its server (an untrusted certificate, a refused key) fails here,
# with what to check, instead of reporting success; the service keeps retrying.
wait_connected() {
	if "$supervisor" status --storage "$storage" --wait 30s --since "$1"; then
		return 0
	fi
	echo "enrolled, but the Supervisor can't connect to $endpoint yet; it keeps retrying. Fix what is above, then check with: sudo $supervisor status --storage $storage" >&2
	exit 1
}

done=Enrolled
[ -z "$refresh" ] || done=Refreshed
if [ -n "$start" ]; then
	# The unmanaged collector conflicts with the Supervisor: disabled, it doesn't come back at boot.
	"$systemctl" disable --now pydantic-otelcol.service
	"$systemctl" enable "$unit"
	started=$(date +%s)
	"$systemctl" restart "$unit"
	wait_connected "$started"
	echo "$done with $endpoint. The Supervisor is running and connected ($unit)."
else
	echo "$done with $endpoint. Start the Supervisor with: systemctl enable --now $unit"
fi
