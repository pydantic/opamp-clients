<Project Sdk="Microsoft.NET.Sdk">

  <!-- An application with automatic instrumentation from the NuGet package, the plugin next to it. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>App</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- ASP.NET Core, for the requests it serves with APP_LISTEN set (sampling_rules' path). -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="8.0.1" />
    <PackageReference Include="OpenTelemetry.AutoInstrumentation" Version="1.17.0" />
    <ProjectReference Include="../../dotnet/Pydantic.OpAmp.AutoInstrumentation/Pydantic.OpAmp.AutoInstrumentation.csproj" />
  </ItemGroup>

</Project>
